# ============================================================================
# 環境変数(仕様書 §13)
# このファイルをコピーして `.env.local` を作成し、各値を埋めること。
# `.env.local` は .gitignore で除外済み。
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用キー(クライアントから絶対に参照しない / 仕様書 §12.4)
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 移行スクリプト用(仕様書 §6, §13)
# ----------------------------------------------------------------------------
MIGRATE_SOURCE_DIR=./csv
MIGRATE_ERROR_DIR=./errors

# ----------------------------------------------------------------------------
# Google Drive 定期取込(#1 / CLAUDE.md §5.10c) — サーバー専用
# サービスアカウントキー(JSON)をそのまま1行で設定する。
# 取込対象のファイル/フォルダを、このSAの client_email に「閲覧者」で共有すること。
# 例: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
# ----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------------
# メール一元管理(CLAUDE.md §5.15) — サーバー専用
# Vercel では AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY が予約名のため
# MAIL_ 接頭辞にしている(SDK クライアントへ明示的に渡す)。
# ----------------------------------------------------------------------------
MAIL_AWS_REGION=ap-northeast-1
MAIL_AWS_ACCESS_KEY_ID=           # SES 送信 + 受信バケット読取 の IAM ユーザー
MAIL_AWS_SECRET_ACCESS_KEY=
MAIL_INBOUND_BUCKET=              # SES 受信ルールが生 MIME を置く S3 バケット
MAIL_SNS_TOPIC_ARN=               # 受信・配信状態の SNS トピック(Webhook で TopicArn を検証)
MAIL_INBOUND_ADDRESS=             # 全共有アドレス共通の受信用アドレス(各サーバーの転送先に登録)
MAIL_SES_CONFIGURATION_SET=kwk-crm-mail   # 送信の配信状態(配信/不達)を受け取る SES 設定セット(任意)
