{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInboundMail",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::kwk-crm-mail-inbound/inbound/*"
    },
    {
      "Sid": "SendMail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    },
    {
      "Sid": "CheckSendingDomain",
      "Effect": "Allow",
      "Action": ["ses:GetEmailIdentity"],
      "Resource": "*"
    }
  ]
}
